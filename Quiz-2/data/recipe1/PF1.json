{
  "name": "Candy Cane Brownie",
  "description": "Dense two-bite brownies with peppermint icing and crushed candy canes. Easy to make with just a whisk!",
  "ingredients": {
    "Brownie": [
      "1/2 cup (125 mL) butter",
      "2 oz (57 g) unsweetened chocolate, chopped",
      "2 eggs",
      "1 cup (250 mL) granulated sugar",
      "1/2 tsp (2 mL) vanilla",
      "1/3 cup (75 mL) all-purpose flour",
      "1/3 cup (60 mL) cocoa powder",
      "1/4 tsp (1 mL) salt"
    ],
    "Icing": [
      "1 cup (250 mL) icing sugar",
      "2 tbsp (30 mL) butter, softened",
      "2 tsp (10 mL) milk",
      "1 tsp peppermint extract",
      "4–12 mini candy canes"
    ]
  },
  "instructions": [
    "Line a mini-muffin pan with small paper liners.",
    "Preheat oven to 350°F (180°C).",
    "Fill a small saucepan with 2 inches of water and place on low heat.",
    "Place a heatproof bowl over the saucepan of hot water.",
    "Add butter and chocolate to the bowl.",
    "Stir occasionally until melted and smooth.",
    "Remove the bowl from heat and let the mixture cool.",
    "In a large mixing bowl, whisk together eggs and sugar until creamy.",
    "Whisk in the cooled chocolate mixture and vanilla.",
    "Use a spatula to scrape all chocolate from the bowl.",
    "In another bowl, whisk together flour, cocoa powder, and salt.",
    "Add dry ingredients to the chocolate mixture.",
    "Whisk until blended.",
    "Spoon 1 tablespoon of batter into each muffin cup.",
    "Bake for about 12 minutes or until a toothpick comes out with moist crumbs.",
    "Remove from oven and let brownies cool completely.",
    "In a small bowl, combine icing sugar, softened butter, milk, and peppermint extract.",
    "Mix until soft and fluffy.",
    "Spread icing over cooled brownies using a knife or piping bag.",
    "Peel plastic from mini candy canes.",
    "Place candy canes in a bowl and crush them coarsely.",
    "Sprinkle crushed candy canes on top of the icing.",
    "Serve and enjoy."
  ]
}
